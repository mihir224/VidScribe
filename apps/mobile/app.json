{
  "expo": {
    "name": "VidScribe",
    "slug": "vidscribe",
    "scheme": "vidscribe",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vidscribe.mobile"
    },
    "android": {
      "package": "com.vidscribe.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "www.youtube.com"
            },
            {
              "scheme": "https",
              "host": "youtu.be"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
